<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive launcher icon (API 26+).

     Layers are generated by tool/generate_icons_from_image.py from
     assets/Puzzle.png: the foreground is the artwork inset into the 72dp
     safe zone, the background is a violet sampled from the artwork's own
     frame so the two blend seamlessly under any launcher mask shape. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
